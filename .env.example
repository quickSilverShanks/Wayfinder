# Wayfinder Document Ingestion Pipeline Configuration

# Source directory containing PDF documents to ingest
SOURCE_DOCUMENT_DIR=./data/source_documents

# Directory where ChromaDB vector database will persist its data
CHROMA_PERSIST_DIR=./data/chroma_db

# Ollama API Base URL
OLLAMA_BASE_URL=http://localhost:11434

# Embedding model hosted on Ollama (e.g., nomic-embed-text, all-minilm, mxbai-embed-large)
EMBEDDING_MODEL=nomic-embed-text

# Chat model hosted on Ollama (e.g., llama3.2, mistral, phi3)
CHAT_MODEL=llama3.2

# Document chunking settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# PII Masking toggle (True/False)
PII_MASKING_ENABLED=True

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Prefect Server API URL (Leave blank for ephemeral execution or http://localhost:4200/api if running Prefect server)
PREFECT_API_URL=http://localhost:4200/api

# CSV Ledger Path (tracks all ingested documents, upload times, and vectorization status)
INGESTION_LOG_CSV=./data/ingested_documents.csv

# Folder Watcher Polling Interval (in seconds)
WATCH_INTERVAL_SECONDS=5

# ==============================================================================
# Part 2: Search & Retrieval Backend Configuration
# ==============================================================================

# Search result limits
DEFAULT_TOP_K=5
MIN_TOP_K=1
MAX_TOP_K=50

# Retrieval candidate pool sizes
DENSE_TOP_K=15
BM25_TOP_K=15
RERANK_TOP_K=25

# Relevance threshold (results with reranker score >= threshold qualify as relevant)
RELEVANCE_THRESHOLD=0.20

# Reranker model identifier (BAAI/bge-reranker-v2-m3)
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=auto

